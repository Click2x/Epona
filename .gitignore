# ---- never commit the game or anything made from it ----
# (decompressed modules, the loaded image, lifted C, test builds, romfs/exefs copies, dumps, keys)
work/
gen/
image/
exefs/
romfs/
*.bin
*.keys
*.nso
*.nca
*.nsp
*.xci
gamefile/
*.nup
*.nsz
*.xcz

# ---- build output and caches ----
build/
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.sha1
*.log

# ---- data fetched for review, before it is used (scripts/epona_fetch_work_data.py) ----
work_incoming/

# ---- generated announcement drafts (only a final one, made with --link, is meant to be committed) ----
docs/img/*DRAFT*
docs/img/*-GAME.png
docs/img/announcement.html

# ---- local agent coordination notes ----
.agent-board/

# ---- the compiler make_game.py downloads (llvm-mingw) ----
llvm-mingw/

# ---- Linux builds ----
build-linux/
*.so
